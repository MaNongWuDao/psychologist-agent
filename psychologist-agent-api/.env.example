#  模型 
# 可选值：dashscope | openai | demo
# 留空（或删掉这一行）时自动探测：先看 DASHSCOPE_API_KEY，再看 OPENAI_API_KEY，
# 都没有则使用本地演示模型（离线可跑）。
LLM_PROVIDER=

# 阿里云百炼 / DashScope（OpenAI 兼容模式）
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_TEMPERATURE=0.6
# 默认 https://dashscope.aliyuncs.com/compatible-mode/v1
# 专属部署（workspace 级 MaaS 域名）请填自己的地址
# DASHSCOPE_BASE_URL=

# OpenAI 或其它兼容 OpenAI 协议的网关
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.6
# OPENAI_BASE_URL=https://api.openai.com/v1

#  存储 
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/psychologist
# auto | postgres | memory
# auto：连不上数据库时自动降级为内存存储
PERSISTENCE=auto

#  服务 
PORT=3000
CORS_ORIGIN=*
